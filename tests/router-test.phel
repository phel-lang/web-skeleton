(ns web-skeleton-tests.router-test
  (:require web-skeleton.router :as router)
  (:require web-skeleton.middleware :as mw)
  (:require phel.http :as h)
  (:require phel.router :as r)
  (:require phel.json :as json)
  (:require phel.test :refer [deftest is]))

(defn- request [method path]
  (router/app (h/request-from-map {:method method :uri (str "http://localhost" path)})))

(deftest route-table-is-plain-data
  (is (= 4 (count router/routes))))

(deftest get-ping-routes-to-handler
  (let [res  (request "GET" "/ping")
        body (json/decode (:body res))]
    (is (= 200 (:status res)))
    (is (= "pong" (:message body)))))

(deftest unknown-path-returns-404
  (is (= 404 (:status (request "GET" "/nope")))))

(deftest wrong-method-returns-405
  ;; The router rejects unsupported methods — handlers never see them.
  (is (= 405 (:status (request "DELETE" "/ping")))))

(deftest not-found-carries-server-header
  (is (= "phel-web-skeleton" (get-in (request "GET" "/nope") [:headers :server]))))

(deftest method-not-allowed-carries-server-header
  (is (= "phel-web-skeleton" (get-in (request "DELETE" "/ping") [:headers :server]))))

(deftest throwing-not-found-handler-becomes-500-with-server-header
  (let [app (mw/compose router/global-middleware
                        (r/handler (r/router [["/x" {:get {:handler (fn [_] {:status 200})}}]])
                                   {:not-found (fn [_] (throw (new Exception "boom")))}))
        res (app (h/request-from-map {:method "GET" :uri "http://localhost/missing"}))]
    (is (= 500 (:status res)))
    (is (= "phel-web-skeleton" (get-in res [:headers :server])))))

(deftest head-on-json-route-serves-get-without-body
  (let [res (request "HEAD" "/ping")]
    (is (= 200 (:status res)))
    (is (= "application/json" (get-in res [:headers :content-type])))
    (is (= "" (:body res)))))

(deftest head-on-html-route-serves-get-without-body
  (let [res (request "HEAD" "/")]
    (is (= 200 (:status res)))
    (is (= "text/html; charset=utf-8" (get-in res [:headers :content-type])))
    (is (= "" (:body res)))))

(deftest head-on-unknown-path-returns-404
  (is (= 404 (:status (request "HEAD" "/nope")))))

(deftest head-on-post-only-route-returns-405
  (is (= 405 (:status (request "HEAD" "/greet")))))

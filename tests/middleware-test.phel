(ns web-skeleton-tests.middleware-test
  (:require web-skeleton.middleware :as mw)
  (:require web-skeleton.http.response :as resp)
  (:require phel.json :as json)
  (:require phel.test :refer [deftest is]))

(deftest wrap-exception-catches-and-returns-500
  (let [boom (fn [_req] (throw (new Exception "boom")))
        res  (mw/wrap-exception boom {})]
    (is (= 500 (:status res)))
    (is (= "internal server error" (:error (json/decode (:body res)))))))

(deftest wrap-exception-passes-through-success
  (let [inner (fn [_req] {:status 200})
        res   (mw/wrap-exception inner {})]
    (is (= 200 (:status res)))))

(deftest wrap-server-header-tags-response
  (let [inner (fn [_req] {:status 200 :headers {}})
        res   (mw/wrap-server-header inner {})]
    (is (= "phel-web-skeleton" (get-in res [:headers :server])))))

(deftest wrap-exception-turns-unencodable-body-into-500
  (let [inner (fn [_req] (resp/ok {:x "\xFF"}))
        res   (mw/wrap-exception inner {})]
    (is (= 500 (:status res)))
    (is (= "internal server error" (:error (json/decode (:body res)))))))

(deftest compose-puts-first-middleware-outermost
  (let [tag (fn [label]
              (fn [handler request]
                (let [res (handler request)]
                  (assoc res :order (vec (cons label (get res :order [])))))))
        app (mw/compose [(tag "a") (tag "b")] (fn [_] {:status 200}))]
    (is (= ["a" "b"] (:order (app {}))))))

(deftest server-header-outermost-tags-exception-500
  (let [app (mw/compose [mw/wrap-server-header mw/wrap-exception]
                        (fn [_] (throw (new Exception "boom"))))
        res (app {})]
    (is (= 500 (:status res)))
    (is (= "phel-web-skeleton" (get-in res [:headers :server])))))

(deftest wrap-exception-logs-class-message-and-location
  (let [log      (php/tempnam (php/sys_get_temp_dir) "pws-log")
        previous (php/ini_get "error_log")
        _        (php/ini_set "error_log" log)
        boom     (fn [_req] (throw (new RuntimeException "boom")))
        _        (mw/wrap-exception boom {})
        _        (php/ini_set "error_log" previous)
        logged   (php/file_get_contents log)]
    (php/unlink log)
    (is (php/str_contains logged "RuntimeException: boom"))
    (is (= 1 (php/preg_match "/ at .+:[0-9]+/" logged)))))

(deftest wrap-security-headers-adds-hardening-headers
  (let [res (mw/wrap-security-headers (fn [_req] {:status 200 :headers {}}) {})]
    (is (= "nosniff" (get-in res [:headers :x-content-type-options])))
    (is (= "DENY" (get-in res [:headers :x-frame-options])))
    (is (= "no-referrer" (get-in res [:headers :referrer-policy])))
    (is (php/str_contains (get-in res [:headers :content-security-policy]) "default-src 'self'"))))

(deftest wrap-security-headers-keeps-handler-headers
  (let [res (mw/wrap-security-headers (fn [_req] {:status 200 :headers {:x-frame-options "SAMEORIGIN"}}) {})]
    (is (= "SAMEORIGIN" (get-in res [:headers :x-frame-options])))))

(ns web-skeleton.middleware
  (:require web-skeleton.config :as cfg)
  (:require web-skeleton.http.response :as resp))

(defn wrap-exception
  "Outermost middleware: catches any uncaught error from an inner handler and
  answers a JSON 500 instead of leaking a stack trace to the client. The cause
  is logged server-side. Wire it first in the `:middleware` vector."
  [handler request]
  (try
    (handler request)
    (catch Throwable e
      (php/error_log (str "[err] " (php/get_class e) ": " (.getMessage e)
                          " at " (.getFile e) ":" (.getLine e)))
      (php/error_log (str "[err] " (.getTraceAsString e)))
      (resp/internal-error))))

(defn wrap-logger
  "Middleware that prints `METHOD path` for every request before delegating."
  [handler request]
  (let [method (:method request)
        path   (get-in request [:uri :path])]
    (php/error_log (str "[req] " method " " path))
    (handler request)))

(defn wrap-server-header
  "Middleware that tags every response with a `Server` header."
  [handler request]
  (let [response (handler request)]
    (update response :headers assoc :server (:server-header cfg/config))))

(def- security-headers
  {:x-content-type-options  "nosniff"
   :x-frame-options         "DENY"
   :referrer-policy         "no-referrer"
   :content-security-policy "default-src 'self'; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'"})

(defn wrap-security-headers
  "Adds browser hardening headers to every response. Headers the handler set
  win over these defaults."
  [handler request]
  (update (handler request) :headers #(merge security-headers %)))

(defn compose
  "Wraps `handler` in `middlewares`, each a 2-arg `(fn [handler request])`.
  The first entry is outermost."
  [middlewares handler]
  (reduce (fn [inner mw] (partial mw inner)) handler (reverse middlewares)))

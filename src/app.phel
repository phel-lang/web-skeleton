(ns web-skeleton.app
  (:require web-skeleton.router :as router)
  (:require web-skeleton.http.response :as resp)
  (:require phel.http :as h))

;; Entry point: build the request from PHP globals, run it through the app
;; handler, emit the response. The route table and wiring live in
;; web-skeleton.router; everything here is the IO edge.
;; The try wraps parsing and emission too, which sit outside the router's
;; `wrap-exception`, so a throw there still answers a JSON 500 and not a PHP
;; error page.
(when-not *build-mode*
  (try
    (-> (h/request-from-globals)
        router/app
        h/emit-response)
    (catch Throwable e
      (php/error_log (str "[err] " (php/get_class e) ": " (.getMessage e)))
      ;; Drop headers queued before the throw (a handler's Set-Cookie or
      ;; Location) so the 500 does not carry them.
      (when-not (php/headers_sent)
        (php/header_remove))
      (h/emit-response (resp/internal-error)))))
